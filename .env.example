#
# Reasonbook configuration. Copy to `.env` and fill in. All variables are
# prefixed REASONBOOK_. The unprefixed DATABASE_URL is also accepted as an
# alias for REASONBOOK_DATABASE_URL. No secret has a default — the app fails
# fast in production when REASONBOOK_SECRET_KEY is unset.

# --- Core ------------------------------------------------------------------
# production | development | testing
REASONBOOK_FLASK_ENV=development

# HMAC signing key for session JWTs. REQUIRED in production (no default).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
REASONBOOK_SECRET_KEY=

# Database. SQLite by default (a local file). For PostgreSQL, set a
# postgresql+psycopg:// URL (install the [postgres] extra).
REASONBOOK_DATABASE_URL=sqlite:///reasonbook.db
# REASONBOOK_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/reasonbook

# --- Auth ------------------------------------------------------------------
REASONBOOK_JWT_ISSUER=reasonbook
REASONBOOK_JWT_TTL_MINUTES=30

# Comma-separated allowed CORS origins for /api/* (the SPA dev server, etc.).
REASONBOOK_CORS_ORIGINS=http://localhost:5173

# --- Email (SMTP, optional) ------------------------------------------------
# When REASONBOOK_SMTP_HOST is empty: verification/reset links are logged to
# stdout in development and the email flows are disabled in production.
REASONBOOK_SMTP_HOST=
REASONBOOK_SMTP_PORT=587
REASONBOOK_SMTP_USER=
REASONBOOK_SMTP_PASSWORD=
REASONBOOK_SMTP_FROM=

# Public base URL used to build verification/reset links in emails.
REASONBOOK_APP_URL=http://localhost:8000

# --- Logging ---------------------------------------------------------------
REASONBOOK_LOG_LEVEL=INFO
REASONBOOK_LOG_FORMAT=json
# Optional HMAC key for hashing IPs/emails in structured logs (falls back to
# the secret key when empty).
REASONBOOK_PII_HASH_SECRET=

# --- Attachments -----------------------------------------------------------
# local (default) | s3
REASONBOOK_ATTACHMENT_BACKEND=local
REASONBOOK_ATTACHMENT_LOCAL_ROOT=/data/attachments

# S3-compatible object storage — only used when ATTACHMENT_BACKEND=s3.
# Works with AWS S3, MinIO, or any S3-compatible endpoint. No provider default.
REASONBOOK_S3_REGION=
REASONBOOK_S3_BUCKET=
REASONBOOK_S3_ENDPOINT=
REASONBOOK_S3_KEY=
REASONBOOK_S3_SECRET=
REASONBOOK_S3_PRESIGNED_URL_EXPIRY=300

# --- Ingestion scheduler ---------------------------------------------------
# The in-process APScheduler must run in exactly one process (keep gunicorn
# at --workers 1, or set this false on extra workers).
REASONBOOK_RUN_SCHEDULER=true
REASONBOOK_INGESTION_INTERVAL_MINUTES=5

# --- First-run admin + demo seed -------------------------------------------
# When set, a first-run admin is created and a generated password printed once.
REASONBOOK_ADMIN_EMAIL=

# Demo accounts (scripts/seed_dev.py) are NON-PRODUCTION (example.org). They
# are created only when REASONBOOK_SEED_DEMO=true, and need a seed password.
REASONBOOK_SEED_DEMO=false
REASONBOOK_SEED_PASSWORD=
